<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="HomeController">
    <stylesheets>
        <URL value="@dark-theme.css" />
    </stylesheets>
    <top>
        <VBox styleClass="header-box">
            <HBox alignment="CENTER" spacing="20" styleClass="header-content">
                <ImageView fitHeight="50" fitWidth="50">
                    <image>

                    </image>
                </ImageView>
                <Text styleClass="title-text" text="Cinema Booking" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="loginBtn" onAction="#openLoginPage" styleClass="login-button" text="Login" />
            </HBox>

            <HBox spacing="10" styleClass="search-filter-box">
                <TextField fx:id="searchField" promptText="Search movies..." styleClass="search-field" />
                <Button onAction="#handleSearch" styleClass="search-button" text="Search" />

                <ComboBox fx:id="genreFilter" promptText="Filter by Genre" styleClass="filter-combo" />
                <ComboBox fx:id="durationFilter" promptText="Filter by Duration" styleClass="filter-combo" />
                <ComboBox fx:id="timeFilter" promptText="Filter by Show Time" styleClass="filter-combo" />
                <ComboBox fx:id="directorFilter" promptText="Filter by Director" styleClass="filter-combo" />
                <Button onAction="#clearFilters" styleClass="clear-button" text="Clear Filters" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox fx:id="moviesContainer" spacing="20" styleClass="movies-container" />
        </ScrollPane>
    </center>
</BorderPane>
