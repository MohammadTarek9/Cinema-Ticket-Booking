<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<?import java.net.URL?>
<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="HomeController">
    <stylesheets>
        <URL value="@dark-theme.css"/>
    </stylesheets>
    <top>
        <VBox styleClass="header-box">
            <HBox alignment="CENTER" spacing="20" styleClass="header-content">
                <ImageView fitHeight="50" fitWidth="50">
                    <image>

                    </image>
                </ImageView>
                <Text text="Cinema Booking" styleClass="title-text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Login" styleClass="login-button"/>
            </HBox>

            <HBox styleClass="search-filter-box" spacing="10" >
                <TextField fx:id="searchField" promptText="Search movies..." styleClass="search-field"/>
                <Button text="Search" onAction="#handleSearch" styleClass="search-button"/>

                <ComboBox fx:id="genreFilter" promptText="Filter by Genre" styleClass="filter-combo"/>
                <ComboBox fx:id="durationFilter" promptText="Filter by Duration" styleClass="filter-combo"/>
                <ComboBox fx:id="timeFilter" promptText="Filter by Show Time" styleClass="filter-combo"/>
                <ComboBox fx:id="directorFilter" promptText="Filter by Director" styleClass="filter-combo"/>
                <Button text="Clear Filters" onAction="#clearFilters" styleClass="clear-button"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox fx:id="moviesContainer" spacing="20" styleClass="movies-container"/>
        </ScrollPane>
    </center>
</BorderPane>