<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import java.net.URL?>
<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="PaymentController"
            prefWidth="1200" 
            prefHeight="700">
   <stylesheets>
    <URL value="@dark-theme.css"/>
   </stylesheets>


    <top>
        <VBox styleClass="header-box">
            <HBox alignment="CENTER" spacing="20" styleClass="header-content">
                <Text text="Cinema Booking - Payment" styleClass="title-text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Back to Booking" onAction="#goBackToBooking" styleClass="back-button"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="payment-scroll-pane">
            <StackPane>
                <VBox alignment="CENTER" spacing="20" styleClass="payment-content-box">
                    <!-- Booking Summary -->
                    <VBox styleClass="summary-box" spacing="10" alignment="CENTER" maxWidth="800">
                        <Label text="Booking Summary" styleClass="section-title"/>
                        <Label fx:id="movieTitleLabel" styleClass="summary-text"/>
                        <Label fx:id="showtimeLabel" styleClass="summary-text"/>
                        <Label fx:id="seatsLabel" styleClass="summary-text"/>
                        <Label fx:id="itemsLabel" styleClass="summary-text"/>
                        <Label fx:id="totalLabel" styleClass="total-price-text"/>
                    </VBox>

                    <!-- Customer Information -->
                    <VBox styleClass="form-box" spacing="10" alignment="CENTER" maxWidth="800">
                        <Label text="Customer Information" styleClass="section-title"/>
                        <GridPane hgap="10" vgap="10" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT"/>
                                <ColumnConstraints halignment="LEFT"/>
                            </columnConstraints>
                            
                            <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="firstNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-field"/>
                            
                            <Label text="Middle Initial:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="middleInitialField" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field"/>
                            
                            <Label text="Last Name:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="lastNameField" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="form-field"/>
                            
                            <Label text="Phone Number:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <TextField fx:id="phoneField" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="form-field"/>
                            
                            <Label text="Age:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <TextField fx:id="ageField" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="form-field"/>
                            
                            <Label text="Email:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <TextField fx:id="emailField" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="form-field"/>
                        </GridPane>
                    </VBox>

                    <!-- Payment Method -->
                    <VBox styleClass="form-box" spacing="10" alignment="CENTER" maxWidth="800">
                        <Label text="Payment Method" styleClass="section-title"/>
                        <ComboBox fx:id="paymentMethodCombo" styleClass="form-combo"/>
                        
                        <VBox fx:id="paymentDetailsBox" styleClass="form-box" visible="false" alignment="CENTER">
                            <Label text="Payment Details" styleClass="section-title"/>
                            <TextField fx:id="cardNumberField" promptText="Card Number" styleClass="form-field"/>
                            <TextField fx:id="expiryDateField" promptText="MM/YY" styleClass="form-field"/>
                            <TextField fx:id="cvvField" promptText="CVV" styleClass="form-field"/>
                        </VBox>
                    </VBox>

                    <Button text="Confirm Payment" onAction="#confirmPayment" styleClass="confirm-button"/>
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>